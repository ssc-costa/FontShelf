{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FontShelf",
  "version": "0.1.0",
  "identifier": "com.ssccosta.fontshelf",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FontShelf",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true,
        "visible": false,
        "decorations": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https://asset.localhost; font-src 'self' asset: http://asset.localhost https://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost asset: http://asset.localhost https://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/usr/share/fonts/**",
          "$HOME/.local/share/fonts/**",
          "$HOME/.fonts/**",
          "$HOME/Library/Fonts/**",
          "/Library/Fonts/**",
          "/System/Library/Fonts/**",
          "$HOME/AppData/Local/Microsoft/Windows/Fonts/**",
          "C:/Windows/Fonts/**",
          "$APPDATA/**",
          "$LOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ssc-costa",
    "copyright": "Copyright \u00a9 2026 TheHolyOneZ and FontShelf contributors",
    "category": "Utility",
    "homepage": "https://github.com/ssc-costa/FontShelf",
    "shortDescription": "Your fonts, your sample text, your projects.",
    "longDescription": "FontShelf \u2014 a desktop font manager based on ZFontManager by TheHolyOneZ. Browse, preview, compare and organise local fonts with saved phrases. GPL-3.0.",
    "license": "GPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
